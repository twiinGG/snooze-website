    "css": "\n   #snooze-linktree {\n    --c-coral: #F43357;\n    --c-coral-hover: #D62646;\n    --c-navy: #1F293B;\n    --c-cream: #FAF7F4;\n    --c-beige: #F2EDEA;\n    --c-white: #FFFFFF;\n    --c-sage: #7C8A98;\n    --c-text: #161E2A;\n    --c-muted: #64748B;\n\n    --font-body: 'Poppins', sans-serif;\n    --font-head: 'Playfair Display', serif;\n\n    --radius: 20px;\n    --radius-lg: 26px;\n    --shadow-card: 0 10px 30px rgba(31, 41, 59, 0.1);\n    --shadow-soft: 0 6px 16px rgba(31, 41, 59, 0.08);\n    --shadow-hero: 0 20px 48px rgba(244, 51, 87, 0.16);\n    --ring: 0 0 0 4px rgba(244, 51, 87, 0.18);\n\n    font-family: var(--font-body);\n    color: var(--c-text);\n    line-height: 1.6;\n    position: relative;\n    width: 100%;\n    min-height: 100vh;\n    background: var(--c-cream);\n    overflow: hidden;\n    isolation: isolate;\n  }\n\n  #snooze-linktree *,\n  #snooze-linktree *::before,\n  #snooze-linktree *::after {\n    box-sizing: border-box;\n  }\n\n  #snooze-linktree a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n#snooze-linktree .lt-background {\n  position: absolute;\n  inset: 0;\n  background: var(--c-cream);\n  z-index: 0;\n}\n\n  #snooze-linktree .lt-shell {\n    position: relative;\n    z-index: 1;\n    max-width: 480px;\n    margin: 0 auto;\n    padding: 40px 22px 56px;\n  }\n\n  /* Header: brand mark only. Kept small and quiet so the hero, not the\n     header, is the first thing a visitor's eye lands on. */\n  #snooze-linktree .lt-header {\n    display: flex;\n    justify-content: center;\n  }\n\n  #snooze-linktree .lt-brand {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 10px;\n    text-align: center;\n  }\n\n  #snooze-linktree .lt-logo {\n    width: 48px;\n    height: 48px;\n    color: var(--c-coral);\n    display: grid;\n    place-items: center;\n  }\n\n  #snooze-linktree .lt-logo svg {\n    width: 100%;\n    height: 100%;\n  }\n\n  #snooze-linktree .lt-kicker {\n    text-transform: uppercase;\n    letter-spacing: 0.14em;\n    font-size: 0.68rem;\n    font-weight: 600;\n    color: var(--c-muted);\n    margin: 0;\n  }\n\n  /* Hero: the unmistakable focal point. Its own panel, distinct from the\n     link list below, so it reads as one decision rather than one of many\n     equal-weight options. */\n  #snooze-linktree .lt-hero {\n    margin-top: 28px;\n    padding: 32px 24px;\n    border-radius: var(--radius-lg);\n    background: var(--c-white);\n    box-shadow: var(--shadow-hero);\n    text-align: center;\n    display: grid;\n    gap: 18px;\n  }\n\n  #snooze-linktree .lt-hero-eyebrow {\n    margin: 0;\n    font-family: var(--font-head);\n    font-size: clamp(1.3rem, 4.6vw, 1.7rem);\n    line-height: 1.35;\n    color: var(--c-navy);\n    text-wrap: balance;\n  }\n\n  #snooze-linktree .lt-primary {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 17px 24px;\n    background: var(--c-coral-hover); /* T1 a11y: white-on-coral ~3.4:1 -> Coral Deep ~4.97:1 */\n    color: #fff;\n    font-weight: 600;\n    font-size: 1.02rem;\n    border-radius: 999px;\n    box-shadow: 0 14px 28px rgba(244, 51, 87, 0.28);\n    min-height: 56px;\n    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;\n  }\n\n  #snooze-linktree .lt-primary:hover {\n    background: var(--c-coral-hover);\n    transform: translateY(-2px);\n    box-shadow: 0 20px 40px rgba(244, 51, 87, 0.32);\n  }\n\n  #snooze-linktree .lt-primary.is-pressed {\n    transform: translateY(0) scale(0.98);\n  }\n\n  #snooze-linktree .lt-primary:focus-visible {\n    outline: none;\n    box-shadow: var(--ring), 0 16px 30px rgba(244, 51, 87, 0.28);\n  }\n\n  #snooze-linktree .lt-links {\n    margin-top: 28px;\n    display: grid;\n    gap: 12px;\n  }\n\n/* Entrance is a pure-CSS fade-up (animation-fill-mode: backwards), never\n   gated on JS or on scrolling an element into view. A JS/IntersectionObserver\n   -gated reveal (the original page's approach) leaves anything below the\n   fold permanently invisible if the observer never fires: slow JS, JS\n   disabled, or a headless render. Cards are visible by default; the\n   animation only enhances that already-visible state. */\n@keyframes lt-fade-up {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n#snooze-linktree .lt-card {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n    padding: 16px 16px;\n    border-radius: var(--radius);\n    background: rgba(255, 255, 255, 0.95);\n    box-shadow: var(--shadow-card);\n    animation: lt-fade-up 0.5s ease backwards;\n    transition: transform 0.25s ease, box-shadow 0.25s ease, border 0.25s ease, background 0.25s ease;\n  border: 1px solid transparent;\n}\n\n  #snooze-linktree .lt-card:nth-of-type(1) { animation-delay: 0.05s; }\n  #snooze-linktree .lt-card:nth-of-type(2) { animation-delay: 0.13s; }\n  #snooze-linktree .lt-card:nth-of-type(3) { animation-delay: 0.21s; }\n\n  #snooze-linktree .lt-card:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 16px 36px rgba(31, 41, 59, 0.14);\n    border-color: rgba(244, 51, 87, 0.14);\n  }\n\n  #snooze-linktree .lt-card:focus-visible {\n    outline: none;\n    box-shadow: var(--ring), var(--shadow-card);\n  }\n\n  #snooze-linktree .lt-card-title {\n    display: block;\n    font-weight: 600;\n    font-size: 1rem;\n    color: var(--c-navy);\n  }\n\n  #snooze-linktree .lt-card-desc {\n    display: block;\n    font-size: 0.9rem;\n    color: var(--c-muted);\n    margin-top: 4px;\n  }\n\n  #snooze-linktree .lt-card-arrow {\n    font-size: 1.1rem;\n    color: var(--c-coral);\n    flex-shrink: 0;\n  }\n\n  #snooze-linktree .lt-age {\n    display: grid;\n    gap: 10px;\n    padding: 2px 2px 4px;\n  }\n\n  #snooze-linktree .lt-section-title {\n    margin: 0;\n    font-weight: 600;\n    color: var(--c-navy);\n    font-size: 0.92rem;\n    text-align: center;\n  }\n\n  #snooze-linktree .lt-tiles {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 8px;\n  }\n\n  #snooze-linktree .lt-tile {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 10px 6px;\n    border-radius: 999px;\n    background: rgba(255, 255, 255, 0.95);\n    font-weight: 600;\n    color: var(--c-navy);\n    box-shadow: var(--shadow-soft);\n    animation: lt-fade-up 0.5s ease backwards;\n    transition: transform 0.2s ease, box-shadow 0.2s ease;\n    min-height: 44px;\n  }\n\n  #snooze-linktree .lt-tile:nth-of-type(1) { animation-delay: 0.05s; }\n  #snooze-linktree .lt-tile:nth-of-type(2) { animation-delay: 0.09s; }\n  #snooze-linktree .lt-tile:nth-of-type(3) { animation-delay: 0.13s; }\n  #snooze-linktree .lt-tile:nth-of-type(4) { animation-delay: 0.17s; }\n\n#snooze-linktree .lt-tile:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 10px 20px rgba(31, 41, 59, 0.12);\n}\n\n#snooze-linktree .lt-footer {\n  margin-top: 32px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 16px;\n}\n\n#snooze-linktree .lt-site-link {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: var(--c-coral);\n  padding: 6px 4px;\n  transition: color 0.2s ease;\n}\n\n#snooze-linktree .lt-site-link:hover {\n  color: var(--c-coral-hover);\n}\n\n#snooze-linktree .lt-socials {\n  display: inline-flex;\n  gap: 14px;\n  padding: 10px 16px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.9);\n  box-shadow: var(--shadow-soft);\n}\n\n#snooze-linktree .lt-social {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  color: var(--c-navy);\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\n}\n\n#snooze-linktree .lt-social svg {\n  width: 18px;\n  height: 18px;\n  fill: currentColor;\n}\n\n#snooze-linktree .lt-social:hover {\n  transform: translateY(-1px);\n  box-shadow: 0 8px 16px rgba(31, 41, 59, 0.12);\n}\n\n  @media (max-width: 520px) {\n    #snooze-linktree .lt-shell {\n      padding: 32px 18px 48px;\n    }\n\n    #snooze-linktree .lt-hero {\n      padding: 28px 20px;\n    }\n\n    #snooze-linktree .lt-card {\n      padding: 14px 16px;\n    }\n  }\n\n  @media (min-width: 768px) {\n    #snooze-linktree .lt-shell {\n      padding: 56px 24px 72px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #snooze-linktree .lt-card,\n    #snooze-linktree .lt-tile {\n      animation: none;\n      opacity: 1;\n      transform: none;\n      transition: none;\n    }\n\n    #snooze-linktree .lt-primary,\n    #snooze-linktree .lt-primary:hover {\n      transition: none;\n    }\n  }\n",
    "js": "document.addEventListener('DOMContentLoaded', function () {\n  const wrapper = document.getElementById('snooze-linktree');\n  if (!wrapper) return;\n\n  // Card/tile entrance is pure CSS (see lt-fade-up in the stylesheet) so\n  // content is never gated on JS running or on scroll position. This\n  // script only handles the primary button's press feedback.\n  const primary = wrapper.querySelector('[data-primary-link]');\n\n  if (primary) {\n    primary.addEventListener('click', () => {\n      primary.classList.add('is-pressed');\n      setTimeout(() => primary.classList.remove('is-pressed'), 220);\n    });\n  }\n});\n",
