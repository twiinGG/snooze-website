          "type": "code",
          "settings": {
            "code": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n/* System Initialization: self-contained Kajabi landing page. */\n#camp-vsl-page{--forest:#295641;--ink:#233c30;--cream:#faf8f2;--sage:#e5ecdf;--gold:#c38b34;--muted:#526457;--line:#d8dece;--white:#fff;--radius:14px;--shadow:0 14px 40px -22px #233c3050;--heading:'Cormorant Garamond',Georgia,serif;--body:'DM Sans',Arial,sans-serif;background:var(--cream);color:var(--ink);font-family:var(--body);font-size:16px;line-height:1.65;width:100%;isolation:isolate}\n#camp-vsl-page *,#camp-vsl-page *::before,#camp-vsl-page *::after{box-sizing:border-box}\n#camp-vsl-page h1,#camp-vsl-page h2,#camp-vsl-page h3,#camp-vsl-page h4{font-family:var(--heading);font-weight:600;line-height:1.05;letter-spacing:-.025em;text-wrap:balance;margin:0 0 20px;color:inherit}\n#camp-vsl-page h1{font-size:clamp(44px,5.3vw,70px)}#camp-vsl-page h2{font-size:clamp(36px,4vw,50px)}#camp-vsl-page h3{font-size:29px}#camp-vsl-page h4{font-size:24px}\n#camp-vsl-page p{margin:0 0 18px}#camp-vsl-page a{color:inherit;text-underline-offset:4px}#camp-vsl-page img{max-width:100%;display:block}#camp-vsl-page button,#camp-vsl-page input{font:inherit}#camp-vsl-page [hidden]{display:none!important}\n#camp-vsl-page :focus-visible{outline:3px solid var(--gold);outline-offset:5px}#camp-vsl-page ::selection{background:var(--forest);color:var(--cream)}\n#camp-vsl-page .snooze-container{width:min(1080px,calc(100% - 48px));margin-inline:auto}#camp-vsl-page .snooze-section{padding:88px 0}#camp-vsl-page .bg-white{background:var(--white)}\n#camp-vsl-page .btn{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-height:54px;padding:14px 27px;border:1px solid var(--forest);border-radius:7px;background:var(--forest);color:white;text-decoration:none;font-weight:600;cursor:pointer;transition:background .18s ease}\n#camp-vsl-page .btn:hover{background:#1d4030}#camp-vsl-page .btn-outline{background:transparent;color:var(--forest)}#camp-vsl-page .btn-outline:hover{background:var(--sage)}#camp-vsl-page .btn:disabled{opacity:.5;cursor:not-allowed}\n#camp-vsl-page .hero-wrap{padding:48px 0 0}#camp-vsl-page .hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}#camp-vsl-page .steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px}#camp-vsl-page .step-card{padding-top:26px;border-top:1px solid var(--line)}\n#camp-vsl-page>section,#camp-vsl-page>header,#camp-vsl-page>footer,#camp-vsl-page>main{width:100%;max-width:none;margin-inline:0}\n/* Page-specific styles. */\n#camp-vsl-page .masthead{border-bottom:1px solid var(--line)}#camp-vsl-page .masthead-inner{display:flex;align-items:center;justify-content:space-between;padding-block:19px;gap:20px}\n#camp-vsl-page .wordmark{font:700 29px/1 var(--heading);letter-spacing:-.03em;text-decoration:none}#camp-vsl-page .wordmark small{font:400 11px/1 var(--body);letter-spacing:.08em;display:block;margin-top:7px;text-align:center}#camp-vsl-page .masthead a:last-child{font-size:13px}\n#camp-vsl-page .hero-intro{text-align:center;max-width:830px;margin:auto}#camp-vsl-page .audience{font-size:12px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;margin-bottom:20px;color:var(--muted)}\n#camp-vsl-page .hero-intro h1 em{font-weight:500;color:var(--forest)}#camp-vsl-page .lead{font-size:18px;max-width:620px;margin:0 auto 30px;color:var(--muted)}\n#camp-vsl-page .film{max-width:780px;display:grid;grid-template-columns:1fr 1fr;margin:0 auto;background:var(--forest);color:var(--cream);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}\n#camp-vsl-page .film video{width:100%;height:100%;aspect-ratio:4/5;object-fit:contain;background:#183b2a;display:block;m