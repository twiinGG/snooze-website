plain-list{margin-bottom:28px}#camp-vsl-page .included .plain-list li{border-color:var(--line)}#camp-vsl-page .small{font-size:13px;color:var(--muted)}#camp-vsl-page .faq{max-width:780px;margin:auto}#camp-vsl-page .faq h2{text-align:center;margin-bottom:32px}#camp-vsl-page details{border-bottom:1px solid var(--line);padding:20px 0}#camp-vsl-page summary{cursor:pointer;list-style:none;display:flex;align-items:center;justify-content:space-between;gap:22px;font-weight:600;font-size:16px}#camp-vsl-page summary::-webkit-details-marker{display:none}#camp-vsl-page summary::after{content:'+';font-size:24px;font-weight:400}#camp-vsl-page details[open] summary::after{content:'\u2212'}#camp-vsl-page details p{margin:15px 35px 0 0;color:var(--muted)}#camp-vsl-page .final-cta{padding:60px 24px;text-align:center;background:var(--forest);color:var(--cream)}#camp-vsl-page .final-cta .btn{background:var(--cream);color:var(--forest);border-color:var(--cream)}\n#camp-vsl-page .snooze-footer-clean{background:#203d2e;color:var(--cream);padding:54px 24px 24px}#camp-vsl-page .sf-container{max-width:1080px;margin:auto}#camp-vsl-page .sf-grid{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:30px}#camp-vsl-page .sf-logo svg{width:130px;height:45px;fill:var(--cream)}#camp-vsl-page .sf-logo svg path{fill:var(--cream)}#camp-vsl-page .sf-heading{font:600 16px var(--body);margin:0 0 20px;color:var(--cream)}#camp-vsl-page .sf-links{list-style:none;padding:0;margin:0}#camp-vsl-page .sf-links li{margin:9px 0}#camp-vsl-page .sf-links a,#camp-vsl-page .sf-socials a{font-size:12px;text-decoration:none;color:#e5ecdf}#camp-vsl-page .sf-links a:hover,#camp-vsl-page .sf-socials a:hover{text-decoration:underline}#camp-vsl-page .sf-tagline{font-size:12px;color:#e5ecdf}#camp-vsl-page .sf-socials{display:flex;gap:12px;flex-wrap:wrap}#camp-vsl-page .sf-bottom{border-top:1px solid #ffffff30;margin-top:36px;padding-top:22px;font-size:11px;color:#e5ecdf}\n#camp-vsl-page .skip-link{position:absolute;left:16px;top:-100px;background:white;padding:10px;z-index:2}#camp-vsl-page .skip-link:focus{top:10px}\n@media(max-width:700px){#camp-vsl-page .snooze-container{width:calc(100% - 36px)}#camp-vsl-page .snooze-section{padding:58px 0}#camp-vsl-page .hero-wrap{padding-top:34px}#camp-vsl-page .audience{font-size:10px;letter-spacing:.08em}#camp-vsl-page .lead{font-size:16px}#camp-vsl-page .film{grid-template-columns:1fr}#camp-vsl-page .film-copy{padding:24px}#camp-vsl-page .film video{height:400px;max-height:none}#camp-vsl-page .film h2{font-size:28px}#camp-vsl-page .film p{font-size:12px}#camp-vsl-page .film .duration{font-size:11px;margin-bottom:10px}#camp-vsl-page .film a{font-size:12px}#camp-vsl-page .film video{min-height:270px}#camp-vsl-page .fit{padding:25px 20px;margin-top:24px}#camp-vsl-page .fit h2{font-size:30px}#camp-vsl-page .fit-columns,#camp-vsl-page .steps-grid,#camp-vsl-page .coaches,#camp-vsl-page .included,#camp-vsl-page .responsibilities,#camp-vsl-page .parent-quotes{grid-template-columns:1fr;gap:30px}#camp-vsl-page .coaches{gap:40px}#camp-vsl-page .coach-images{max-width:430px}#camp-vsl-page .sf-grid{grid-template-columns:1fr 1fr;gap:30px}#camp-vsl-page .sf-col:first-child{grid-column:1/-1}#camp-vsl-page .proof{padding-bottom:38px}#camp-vsl-page .parent-quotes{margin-top:40px}#camp-vsl-page .choices{grid-template-columns:1fr 1fr}}\n@media(max-width:380px){#camp-vsl-page .film{grid-template-columns:1fr}#camp-vsl-page .film video{height:360px}#camp-vsl-page .film-copy{padding:22px}#camp-vsl-page .choices{grid-template-columns:1fr}}\n@media(prefers-reduced-motion:reduce){#camp-vsl-page *{scroll-behavior:auto!important;transition:none!important}}\n</style>\n\n<div id=\"camp-vsl-page\">\n<a class=\"skip-link\" href=\"#camp-main\">Skip to content</a>\n<header class=\"masthead\"><div class=\"snooze-container masthead-inner\"><a class=\"wordmark\" href=\"https://www.joinsnooze.com/camp-snooze-sleep-coaching\" aria-label=\"Camp Snooze home\">camp snooze<small>BY THE SLEEP CONCIERGE</small></a><a href=\"#camp-faq\">Your questions, answered</a></div></header>\n<main id=\"camp-main\">\n<section class=\"hero-wrap\"><div class=\"snooze-container\">\n<div class=\"hero-intro\"><p class=\"audience\">For parents of babies aged 6 months and over</p><h1>A plan for your baby.<br><em>Two weeks of support for you.</em></h1><p class=\"lead\">Work on your baby\u2019s sleep with Sally and Bec beside you. A personalised plan, daily coaching and help when things don\u2019t go to plan.</p></div>\n<div class=\"film\"><video controls playsinline preload=\"metadata\" poster=\"https://tscmedia.khorus.ai/website/camp-vsl/2026-10-24/6a1cf9575b07-how-camp-4x5-poster.jpg\" aria-label=\"Sally explains daily coaching at Camp Snooze\"><source src=\"https://tscmedia.khorus.ai/website/camp-vsl/2026-10-24/da14d0e19cf7-how-camp-4x5.mp4\" type=\"video/mp4\"><track kind=\"captions\" data-camp-captions=\"true\" srclang=\"en\" label=\"English\">Your browser cannot play this video. Read how Camp works below.</video><div class=\"film-copy\"><p class=\"duration\">A LOOK INSIDE CAMP \u00b7 29 SECONDS</p><h2>You try it.<br>We work through it with you.</h2><p>See how daily feedback helps you put your baby\u2019s plan into practice.</p><a href=\"#how-camp-works\">Prefer to read? Here\u2019s how it works.</a></div></div>\n<section class=\"fit\" id=\"camp-fit\" aria-labelledby=\"fit-title\"><div class=\"step-label\"><span id=\"step-label\">A quick Camp fit check</span><span class=\"progress\" aria-hidden=\"true\"><i class=\"current\"></i><i></i></span></div><h2 id=\"fit-title\">Find your next step</h2><p class=\"fit-intro\">Two quick questions. No email needed.</p>\n<form id=\"fit-form\" novalidate>\n<fieldset id=\"fit-age\"><legend>How old is your baby?</legend><div class=\"choices\"><label class=\"choice\"><input type=\"radio\" name=\"age\" value=\"under6\" required>Under 6 months</label><label class=\"choice\"><input type=\"radio\" name=\"age\" value=\"6to12\">6\u201312 months</label><label class=\"choice\"><input type=\"radio\" name=\"age\" value=\"over12\">Over 12 months</label><label class=\"choice\"><input type=\"radio\" name=\"age\" value=\"unsure\">I\u2019d like to ask first</label></div></fieldset>\n<fieldset id=\"fit-support\" hidden><legend>Does daily group coaching feel right for you?</legend><div class=\"choices\"><label class=\"choice\"><input type=\"radio\" name=\"support\" value=\"ready\">Yes, I\u2019m ready to take part</label><label class=\"choice\"><input type=\"radio\" name=\"support\" value=\"question\">I have a question first</label></div></fieldset>\n<p class=\"form-error\" id=\"fit-error\" role=\"alert\" hidden>Choose an answer to continue.</p><button class=\"btn\" type=\"submit\" id=\"fit-next\">Continue <span aria-hidden=\"true\">\u2192</span></button><button class=\"text-button\" type=\"button\" id=\"fit-back\" hidden>Back</button>\n</form><div id=\"fit-result\" hidden tabindex=\"-1\" role=\"status\"></div>\n<p class=\"privacy-note\">Your answers stay on this page. This is not a booking or a clinical assessment.</p><noscript><p><a href=\"https://www.joinsnooze.com/camp-snooze-sleep-coaching#pricing-section\">See Camp dates and booking options</a>. The fit check needs JavaScript.</p></noscript>\n</section>\n<div class=\"proof\"><blockquote>\u201cI had my coffee before he was up. Like, it was amazing.\u201d</blockquote><p>From a Camp Snooze participant</p><p class=\"proof-note\">One parent\u2019s experience. Every baby and family is different.</p></div>\n</div></section>\n<section class=\"snooze-section sage-section\"><div class=\"snooze-container fit-columns\"><div><h2>For the nights you\u2019re tired of figuring out alone.</h2><ul class=\"plain-list\"><li>Bedtime takes longer than you expected.</li><li>Your baby wakes often and you\u2019re unsure what to change.</li><li>Naps feel unpredictable.</li><li>You\u2019ve tried advice, but need help putting it into practice.</li></ul></div><div class=\"aside-note\"><h3>Come ready to take part.</h3><p>Camp is a two-week online group experience for families with babies aged six months and over. You\u2019ll put your plan into practice, share updates and work through adjustments with your coaches.</p><p>If your baby is younger, or you\u2019re unsure whether group coaching suits your family, ask us first.</p><a href=\"mailto:camp@joinsnooze.com?subject=Is%20Camp%20Snooze%20right%20for%20us%3F\">Ask about Camp</a></div></div></section>\n<section class=\"snooze-section\" id=\"how-camp-works\"><div class=\"snooze-container\"><div class=\"section-intro\"><h2>A clear start.<br>Support as you go.</h2><p>Camp brings the plan and the people helping you follow it into the same place.</p></div><div class=\"steps-grid\"><article class=\"step-card\"><span class=\"step-number\">01</span><h3>Tell us about your baby</h3><p>Complete your intake so your coaches understand what\u2019s happening now and what you want to work towards.</p></article><article class=\"step-card\"><span class=\"step-number\">02</span><h3>Start with your plan</h3><p>Begin Camp with a personalised sleep plan and a kick-off group call to work through your approach.</p></article><article class=\"step-card\"><span class=\"step-number\">03</span><h3>Work through it together</h3><p>Daily roll call and forum support help you review what happened, ask questions and adjust across the two weeks.</p></article></div><div class=\"responsibilities\"><div><h3>We bring the guidance.</h3><p>Your plan, daily coaching and troubleshooting when you\u2019re unsure what to do next.</p></div><div><h3>You bring your real days and nights.</h3><p>Put the plan into practice, keep your sleep logs and share what\u2019s happening so your coaches can help.</p></div></div></div></section>\n<section class=\"snooze-section sage-section\"><div class=\"snooze-container\"><div class=\"coaches\"><div class=\"coach-images\"><figure><img src=\"https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2164288957/settings_images/f702b6a-ea62-2788-5b0-313783348b3_Camp_Snooze_Sally.webp\" alt=\"Sally, Camp Snooze sleep coach\" loading=\"eager\" width=\"400\" height=\"533\"><figcaption>Sally</figcaption></figure><figure><img src=\"https://kajabi-storefronts-production.kajabi-cdn.com/kajabi-storefronts-production/file-uploads/themes/2164288957/settings_images/3ea4276-026f-1eff-af-6c65224d2ae_Camp_Snooze_Bec.webp\" alt=\"Bec, Camp Snooze sleep coach\" loading=\"eager\" width=\"400\" height=\"533\"><figcaption>Bec</figcaption></figure></div><div class=\"coach-copy\"><h2>People in your corner.</h2><p>Sally and Bec guide you through Camp together, with daily coaching and a private forum for the questions that come up along the way.</p><p>Sally is an internationally certified sleep consultant and former paediatric nurse.</p><a href=\"#camp-fit\">Find your next step <span aria-hidden=\"true\">\u2192</span></a></div></div><div class=\"parent-quotes\"><div><blockquote>\u201cI was able to do things\u2026 I was able to do normal things.\u201d</blockquote><cite>Camp Snooze participant</cite></div><div><blockquote>\u201cI could be like on my way to getting my life back a little bit.\u201d</blockquote><cite>Camp Snooze participant</cite></div></div><p class=\"small\" style=\"margin-top:24px\">Shared experiences from Camp participants. Individual results vary.</p></div></section>\n<section class=\"snooze-section\"><div class=\"snooze-container included\"><div><h2>Your two weeks<br>at Camp Snooze.</h2><p>A structured place to work on sleep, with help as you put your plan into practice.</p><p class=\"small\">Camp includes your first month of Snooze access. Review the current price, ongoing access terms and available dates on the booking page before joining.</p></div><div><ul class=\"plain-list\"><li>Personalised sleep plan</li><li>Kick-off group call</li><li>Daily roll call group coaching</li><li>Daily troubleshooting in the private forum</li><li>One month of Snooze access included</li></ul><a class=\"btn\" href=\"https://www.joinsnooze.com/camp-snooze-sleep-coaching#pricing-section\" data-camp-booking>See Camp dates and pricing <span aria-hidden=\"true\">\u2192</span></a></div></div></section>\n<section class=\"snooze-section bg-white\" id=\"camp-faq\"><div class=\"snooze-container\"><div class=\"faq\"><h2>A few things you might be wondering.</h2><details><summary>What age is Camp Snooze for?</summary><p>Camp is designed for babies aged six months and over. If your baby is younger or you\u2019re unsure about suitability, <a href=\"mailto:camp@joinsnooze.com\">email us</a> before booking.</p></details><details><summary>Is Camp online?</summary><p>Yes. Camp is a two-week virtual group experience with a personalised plan, coaching calls and a private forum.</p></details><details><summary>Do I need to attend the calls live?</summary><p>Live is best for real-time support. Replays are available, and you\u2019ll still need to put your plan into practice that day.</p></details><details><summary>What if I\u2019ve tried sleep training before?</summary><p>Many parents have. Daily coaching and troubleshooting give you somewhere to bring your questions when things don\u2019t go as expected.</p></details><details><summary>What happens after the two weeks?</summary><p>Your first month of Snooze access is included. Ongoing Snooze access has separate renewal terms. Check the current pricing and cancellation details on the booking page before you join.</p></details><details><summary>Will my baby sleep through in two weeks?</summary><p>There is no promise that every baby will sleep through by a particular date. Camp provides a personalised plan and two weeks of coaching to help you work on your baby\u2019s sleep.</p></details><details><summary>How much is Camp, and when does it start?</summary><p>The booking page shows current prices, dates and availability. <a href=\"https://www.joinsnooze.com/camp-snooze-sleep-coaching#pricing-section\" data-camp-booking>See Camp dates and pricing</a>.</p></details></div></div></section>\n<section class=\"final-cta\"><h2>You don\u2019t have to work it out alone.</h2><p>Take a look at the next Camp and what\u2019s included.</p><a class=\"btn\" href=\"#camp-fit\">Find your next step <span aria-hidden=\"true\">\u2192</span></a></section>\n</main>\n\n<footer class=\"snooze-footer-clean\">\n  <div class=\"sf-container\">\n    <div class=\"sf-grid\">\n\n      <div class=\"sf-col sf-brand-col\">\n        <div class=\"sf-logo\">\n          <a href=\"/\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"150\" viewBox=\"0 0 750 262.499992\" height=\"52\" preserveAspectRatio=\"xMidYMid meet\" version=\"1.0\" style=\"max-height: 52px;\">\n              <path fill=\"#ffffff\" d=\"M 68.695312 184.851562 C 62.671875 184.851562 56.769531 183.949219 50.992188 182.148438 C 45.277344 180.40625 40.835938 178.542969 37.667969 176.558594 L 34.871094 182.894531 L 27.605469 182.894531 L 26.390625 148.136719 L 33.195312 148.136719 C 34.125 150.933594 35.679688 154.101562 37.851562 157.640625 C 40.027344 161.121094 42.511719 164.257812 45.308594 167.050781 C 48.226562 169.847656 51.550781 172.207031 55.277344 174.132812 C 59.066406 176.058594 63.105469 177.023438 67.390625 177.023438 C 73.046875 177.023438 77.238281 175.933594 79.972656 173.761719 C 82.765625 171.523438 84.164062 168.109375 84.164062 163.511719 C 84.164062 161.027344 83.542969 158.976562 82.300781 157.359375 C 81.058594 155.746094 79.351562 154.347656 77.175781 153.167969 C 74.753906 151.925781 72.082031 150.871094 69.164062 150 C 66.304688 149.128906 62.765625 148.074219 58.539062 146.832031 C 54.316406 145.589844 50.679688 144.347656 47.636719 143.105469 C 44.65625 141.800781 41.550781 139.78125 38.320312 137.046875 C 35.523438 134.625 33.289062 131.707031 31.609375 128.289062 C 29.933594 124.871094 29.09375 120.804688 29.09375 116.082031 C 29.09375 107