{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://joinsnooze.com/get-started/flow.schema.json",
  "title": "Get started flow",
  "description": "Structure of the /get-started onboarding flow (GS-001). Screens, options, branching, plan layout and event names. No copy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "storage_key", "page_path", "age_bands", "screens", "plan_layout", "events"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "storage_key": { "type": "string", "minLength": 1 },
    "page_path": { "type": "string", "pattern": "^/" },
    "age_bands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "months"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "group": { "type": "string", "minLength": 1 },
          "months": {
            "type": "array",
            "items": { "type": "number", "minimum": 0 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/screen" }
    },
    "plan_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "support_cards", "highlight_by_help_style", "safety_route"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "support_cards": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "highlight_by_help_style": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        },
        "safety_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["when_any_red_flag", "show_safety_note", "highlight", "snooze_position", "suppress_sections"],
          "properties": {
            "when_any_red_flag": { "type": "boolean" },
            "show_safety_note": { "type": "boolean" },
            "highlight": { "type": "string", "minLength": 1 },
            "snooze_position": { "type": "string", "enum": ["primary", "secondary"] },
            "suppress_sections": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": ["start", "step", "resume", "email_captured", "plan_viewed", "option_click", "safety_route"],
      "properties": {
        "start": { "type": "string" },
        "step": { "type": "string" },
        "resume": { "type": "string" },
        "email_captured": { "type": "string" },
        "email_captured_alias": { "type": "string" },
        "plan_viewed": { "type": "string" },
        "option_click": { "type": "string" },
        "safety_route": { "type": "string" }
      }
    }
  },
  "definitions": {
    "screen": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["intro", "single", "multi", "interstitial", "building", "email", "plan"]
        },
        "progress": { "type": "boolean" },
        "terminal": { "type": "boolean" },
        "cta_key": { "type": "string" },
        "auto_advance_ms": { "type": "integer", "minimum": 0 },
        "min": { "type": "integer", "minimum": 0 },
        "exclusive_option": { "type": "string" },
        "options": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "options_from": { "type": "string", "minLength": 1 },
        "options_by_group": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "extra_toggle": { "type": "string" },
        "red_flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "show_if": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer"],
          "properties": {
            "answer": { "type": "string", "minLength": 1 },
            "count_gte": { "type": "integer", "minimum": 0 }
          }
        },
        "default_if_hidden": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "pick"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "pick": { "type": "string", "enum": ["first", "last"] }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
